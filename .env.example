# =============================================
# Configuration de l'assistant domotique
# Copier ce fichier en .env et adapter les valeurs
# =============================================

# --- Home Assistant ---
HA_URL=http://maison.local:8123
HA_TOKEN=ton_token_long_lived_ici
MES_PIECES=Salon,Cuisine,Chambre,Cellier,Bureau,Extérieur,Pergola,Serre

# --- Raspberry Pi / Whisper ---
RASPBERRY_PI_IP=maison.local
# WHISPER_URL=  # Si vide, construit automatiquement depuis RASPBERRY_PI_IP

# --- Mode de transcription ---
# "vosk"   → Vosk local temps réel (Linux uniquement, recommandé si pas de Raspberry Pi)
# "remote" → Faster-Whisper sur le Raspberry Pi (meilleure précision)
# "local"  → whisper.cpp en local (si pas de Raspberry Pi)
# Sur Windows → remote ou local automatiquement (Vosk non disponible)
TRANSCRIPTION_MODE=vosk

# --- Chemins whisper.cpp (mode local uniquement) ---
WHISPER_BIN=/home/user/projets/speach/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/user/projets/speach/whisper.cpp/models/ggml-base.bin
WHISPER_VAD_MODEL=/home/user/projets/speach/whisper.cpp/models/for-tests-silero-v6.2.0-ggml.bin

# --- Vosk ---
VOSK_MODEL_PATH=/home/user/vosk-model-fr

# --- Audio ---
ALSA_DEVICE=plughw:CARD=Bar,DEV=0
WINDOWS_MIC=Microphone (Realtek(R) Audio)

# --- GSM ---
GSM_PORT=/dev/ttyUSB0
GSM_PIN=1234

# --- Piper ---
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper-voices/fr_FR-siwis-medium.onnx

# --- Notify ---
NOTIFY_DEVICE=

# --- Modem ---
MODEM_URL=http://192.168.1.1
MODEM_PASSWORD=
MODEM_VERIF_KEY=
MODEM_XOR_KEY=
MODEM_FREE_KEY=
MODEM_HMAC_KEY=
WHITELIST=

# --- API HTTP ---
API_PORT=8080
API_KEY=

# --- Gemini ---
GEMINI_ACTIVE=true
GEMINI_PRIMARY=true
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# true = journalise (niveau INFO) le prompt/contexte envoyé à Gemini, sa réponse brute et le nombre de tokens.
# Sinon ces traces apparaissent avec LOG_LEVEL=debug.
GEMINI_DEBUG=false
# Réduit le contexte envoyé à Gemini aux entités les plus proches de la phrase
# (+ scripts, météo, minuteurs, lecteurs média). false = tout est envoyé à chaque appel.
GEMINI_PRESELECTION=true
GEMINI_CONTEXT_MAX=40
# Mémoire de conversation, par session (voix, chaque numéro SMS, chaque conversation HA).
# GEMINI_MEMOIRE_TOURS=0 la désactive.
GEMINI_MEMOIRE_TOURS=3
GEMINI_MEMOIRE_SECONDES=180
# Garde-fous : confirmation orale avant un SMS ou une automatisation, et numéros
# que l'IA peut viser (séparés par des virgules ; vide = WHITELIST).
IA_CONFIRMATION=true
IA_NUMEROS_AUTORISES=
# Quotas locaux (0 = illimité) : évitent de dépasser le quota du compte Gemini.
# Après un 429 ou 3 échecs consécutifs, l'IA est suspendue puis le NLP classique prend le relais.
GEMINI_MAX_REQUETES_MINUTE=0
GEMINI_MAX_REQUETES_JOUR=0
GEMINI_MAX_TOKENS_MINUTE=0
GEMINI_DELAI_MIN_MS=2000
# Rappelle Gemini une fois, avec le motif précis, quand le code rejette sa réponse.
GEMINI_SECONDE_CHANCE=true
# Second appel de l'IA : commente les chiffres lus par le code (« est-ce normal ? ») et met en
# forme le briefing (avec le saint du jour, qu'elle connaît).
GEMINI_ANALYSE=true
# Mode ombre : l'autre moteur (NLP classique ⇄ IA) dit ce qu'il aurait fait, sans exécuter ;
# les désaccords sont journalisés. Consomme des appels IA quand c'est le NLP classique qui exécute.
IA_OMBRE=false
# Journal des décisions (JSONL) : phrase, moteur, type, actions, résultat, tokens, durée. Vide = mémoire seule.
DECISIONS_FILE=data/decisions.jsonl
# Rotation : au-delà de N Mo le journal est archivé (decisions.jsonl.1, .2…) ; 0 = jamais. « Oublie tout » efface tout.
DECISIONS_MAX_MO=5
DECISIONS_ANCIENS=3
# Phrases comprises par l'IA et réussies, réutilisées quand l'IA n'est pas disponible. Vide = mémoire seule.
NLP_APPRIS_FILE=data/nlp_appris.json
# Notification sur le téléphone (« envoie-moi ça ») : service notify.* de l'app mobile HA.
# Vide = détection automatique de notify.mobile_app_*.
NOTIFY_SERVICE=
# Publication dans Home Assistant : capteurs sensor.assistant_* et un événement par commande.
HA_PUBLISH=true
HA_PUBLISH_INTERVAL_S=60
HA_EVENT_NAME=ha_command_gateway_command
HA_PUBLISH_PHRASE=true

# --- Mealie (menu du briefing, plan de repas, recettes) ---
# MEALIE_URL est l'INTERRUPTEUR : vide = AUCUN appel à Mealie (ni menu dans le briefing, ni plan de repas,
# ni recherche de recettes). Ex. http://maison.local:9925
MEALIE_URL=
# Jeton d'API (profil utilisateur Mealie) : requis pour chercher / planifier une recette par son nom.
MEALIE_TOKEN=